<?xml version="1.0" encoding="utf-8"?>
<!-- Keep the package in step with PACKAGE in apps/solidcraft-android/src/storage.rs. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.maartentrekop.solidcraft">

    <!-- Open and save designs anywhere in the phone's storage, through file paths
         (apps/solidcraft-android/src/storage.rs). Android grants it on its settings page. -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />

    <uses-feature android:name="android.hardware.vulkan.version" android:required="false" />
    <uses-feature android:glEsVersion="0x00030000" android:required="true" />

    <!-- No Java code: NativeActivity loads libsolidcraft_android.so and runs android_main.
         The library is stored uncompressed and page aligned, so Android maps it straight from
         the APK instead of unpacking a copy (extractNativeLibs). -->
    <application
        android:label="SolidCraft"
        android:icon="@mipmap/ic_launcher"
        android:hasCode="false"
        android:extractNativeLibs="false"
        android:resizeableActivity="true"
        android:appCategory="productivity"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar.Fullscreen">

        <!-- configChanges: folding, unfolding, turning, split screen and a keyboard coming or
             going resize the window instead of restarting the activity, which a NativeActivity
             app can't survive (winit opens one event loop per process). -->
        <activity
            android:name="android.app.NativeActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density|keyboard|keyboardHidden|navigation|uiMode|locale|layoutDirection|fontScale|colorMode|touchscreen"
            android:windowSoftInputMode="adjustResize">
            <meta-data android:name="android.app.lib_name" android:value="solidcraft_android" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
